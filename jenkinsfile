pipeline {

    agent {
      label 'Agent1'
    }
    tools {
      maven 'Maven'
     }   

    stages{
        stage ("Build")
        {
            steps {
                sh 'mvn clean package'
            }

        }
        stage ("Test") 
        {
            steps {
                sh 'mvn test'
            }
        }
        stage ("Deploy")
        {
            steps {
            when {
               branch 'main'
            }
             echo "Deploying to production"
        }

             
        

    }
}