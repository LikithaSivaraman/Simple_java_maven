pipeline {

    agent {
      label 'Agent1'
    }
    tools {
      maven 'Maven'
     }   

    stages{
        stage ("Build")
        {
            steps {
                sh 'mvn clean package'
                echo "$BUILD_NUMBER & $BUILD_ID"
            }

        }
        stage ("Test") 
        {
            steps {
                sh 'mvn test'
            }
        }
        stage ("Deploy")
        {
            
            when {
               branch 'xxx'
            }
            steps {
             echo "Deploying to production"
        }

        }    
        

    }
}