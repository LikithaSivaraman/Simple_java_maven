pipeline {

    agent any
    
    environment {
        APP_VERSION = '4.0.${BUILD_NUMBER}'
    }
    tools {
      maven 'Maven'
     }   

    stages{
        stage ("Build")
        {
            steps {
                sh 'mvn clean package'
                echo "$BUILD_NUMBER and $BUILD_ID"
            }

        }
        stage ("Test") 
        {
            steps {
                sh 'mvn test'
            }
            post{
             success {
                archiveArtifacts artifacts: '**/target/*.jar'
             }
            }
        }
        stage ("Deploy")
        {
             steps {
             echo "Deploying to production"
             echo "Appversion= $APP_VERSION"
             }
             }

            
        

    }
}