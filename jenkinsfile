pipeline {

    agent {
     label 'Agent1'
     }

    tools {
      maven 'Maven'
     }   

    stages{
        stage ("Build")
        {
            steps {
                sh 'mvn clean package'
            }
            post {
            success {
                 archieveartifacts artifacts: '**/target/*.war'
            }
            }
        }

    }

}